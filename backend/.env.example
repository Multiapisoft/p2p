# ===========================================
# P2P Payment Platform - Environment Config
# ===========================================

# Application
NODE_ENV=development
PORT=9091
APP_NAME=P2P Payment Platform
API_PREFIX=api/v1

# MongoDB
MONGODB_URI=mongodb://p2p:DkZytPr8RFYTeBRn@84.247.142.251:27017/p2p?authSource=p2p


# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Redis Cache (with prefix for key isolation)
# Set REDIS_ENABLED=false to run without Redis in local dev
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=p2p:
REDIS_DEFAULT_TTL=300

# Default Admin (auto-seeded on first startup)
ADMIN_EMAIL=admin@p2p.local
ADMIN_PASSWORD=Admin@123456
WEBHOOK_SECRET=webhook-signing-secret-change-me
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# INR per 1 USDT (partner USDT wallet → UPI/Bank INR payout)
USDT_INR_RATE=90

# User portal (SSO / partner deposit-withdraw redirects)
USER_APP_URL=http://localhost:5174

# Production example:
# USER_APP_URL=https://dev.app.fairplayofficial.com
# CORS_ORIGINS=https://dev.dashboard.fairplayofficial.com,https://dev.paysecure247.com,https://dev.invespro.xyz,https://dev.app.fairplayofficial.com
# Frontends must proxy with BACKEND_URL=https://dev.payment.fairplayofficial.com (HTTPS, not HTTP)
CORS_ORIGINS=
